{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexusq-refresh-watchdog",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-23",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true },
  "vars": { "ENABLED": "true" }
}
